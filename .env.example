# ==============================================================================
# Window Website Harvester — Optional API Keys & Network Config
# ==============================================================================
# NONE of these keys are required for the free zero-key sources:
#   - overture           (60M+ global POIs via DuckDB over public S3 — ~80k–200k URLs)
#   - commoncrawl_domains (100M+ active domains stream — ~100k–250k URLs)
#   - commoncrawl_cdx    (service-page index across all TLDs — ~30k–100k URLs)
#   - osm                (OpenStreetMap global glazier/window sweep — ~20k–50k URLs)
#   - crtsh              (Certificate Transparency SSL logs — ~30k–80k URLs)
#   - metasearch         (DuckDuckGo + Brave + Startpage/Google + Yahoo/Bing + Mojeek)
#   - yellowpages        (YellowPages.com city × category sweep)
#   - playwright_gmaps   (Direct headless Chromium Google Maps scroller)
#
# Add any of the keys below to unlock ultra-fast Google Maps, Google Search,
# Bing, Brave, and UK Companies House harvesting to reach 300,000–600,000+ URLs.
# ==============================================================================

# 1. Serper.dev (Fastest & cheapest Google Maps + Google Search API: https://serper.dev)
SERPER_API_KEY=

# 2. Official Google Maps Platform Places API (New) (https://console.cloud.google.com)
GOOGLE_PLACES_API_KEY=

# 3. Official Brave Search API (Free tier available: https://brave.com/search/api/)
BRAVE_API_KEY=

# 4. SerpApi — Google Maps, Google, Bing, Bing Maps, DuckDuckGo, Yahoo, Yelp (https://serpapi.com)
SERPAPI_API_KEY=

# 5. DataForSEO — Deep Google Maps (up to 700/call), Google & Bing SERPs (https://dataforseo.com)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# 6. Official UK Companies House API (100% FREE key: https://developer.company-information.service.gov.uk)
#    Pulls every active UK company in Glazing (43342), Metal Windows (25120),
#    uPVC/Plastic Builders' Ware (22230), Joinery (16230), and Flat Glass (23110/23120/23190).
COMPANIES_HOUSE_API_KEY=

# 7. Optional Proxy Pool (comma-separated HTTP/SOCKS5 URLs, or path to proxies.txt)
#    Helpful when running high-volume free metasearch, yellowpages, or playwright_gmaps.
#    Example: http://user:pass@gate.proxy.example:8080,socks5://127.0.0.1:9050
HARVESTER_PROXIES=
HARVESTER_PROXY_FILE=

# 8. Optional default database & output paths
HARVESTER_DB_PATH=data/window_websites.db
HARVESTER_OUTPUT_DIR=output
